# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/jknm"

# better-auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# Required (>=32 chars) in production.
# BETTER_AUTH_SECRET=""
# Must be explicit — an inferred base URL makes Google answer with
# redirect_uri_mismatch. The Google callback is {BETTER_AUTH_URL}/api/auth/callback/google.
BETTER_AUTH_URL="http://localhost:3000"

# Backblaze B2
NEXT_PUBLIC_AWS_MEDIA_BUCKET_NAME="jknm-gradivo"

# Algolia — index name is overridable so a .env.staging can point at a
# separate index (e.g. "published_article_staging") without touching prod.
# NEXT_PUBLIC_ALGOLIA_PUBLISHED_ARTICLE_INDEX="published_article"
